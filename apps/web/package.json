    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "elysia": "^1.4.2",
    "@types/node": "^24.0.0",
    "storybook": "^10.6.2",
    "@storybook/sveltekit": "^10.6.2",
    "@storybook/addon-svelte-csf": "latest",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2"
  },
  "dependencies": {
    "@pt/shared": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
