{
  "name": "program-tracker-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  // Keeps the free Render API awake (it sleeps after ~15 idle minutes).
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "API_ORIGIN": "https://program-tracker-api.onrender.com" },
  "routes": [{ "pattern": "pt.pinroj.com", "custom_domain": true }],
  // Served only at pt.pinroj.com. The account's workers.dev subdomain exists
  // because cron triggers require one; this Worker stays off it.
  "workers_dev": false,
  "preview_urls": false
}
