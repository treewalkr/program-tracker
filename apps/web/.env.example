# Copy to .env (gitignored). SvelteKit exposes PUBLIC_* vars via $env/static/public.
# Where the Elysia API runs.
PUBLIC_API_URL=http://localhost:4000
# mock (default) = keyless in-memory demo; live = real backend at PUBLIC_API_URL.
PUBLIC_API_MODE=live
# Home dashboard transport: rest (default, GET /v1/clients/overview) or graphql (the read-only /v1/graphql trial).
PUBLIC_DASHBOARD_SOURCE=rest
