# --- Database ---
DATABASE_URL=postgres://pt:pt_dev_password@localhost:5433/program_tracker

# --- API ---
API_PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Trainer sign-in (Google) ---
# Every /v1 route needs a signed-in trainer. Create an OAuth "Web application"
# client at console.cloud.google.com → APIs & Services → Credentials and add the
# redirect URI below as an authorized redirect URI (it goes through the web app's
# /v1 proxy, so the session cookie lands on the web origin).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/v1/auth/google/callback
# Platform admin's Google account. Always allowed in; adds other trainers at /admin.
ADMIN_EMAIL=
# AUTH_DISABLED=true   # local hacking only — no sign-in; acts as the oldest trainer, as admin

# --- AI provider ---
# Z.ai pay-as-you-go key (GLM flash models are free tier).
# NOTE: the GLM Coding Plan subscription key is NOT licensed for app embedding —
# use a key from the Z.ai console.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# Model is picked in-app from the provider's model list (override: ZAI_MODEL /
# ZAI_MODELS="m1,m2" env vars).

# DeepSeek (OpenAI-compatible) — optional live provider; key from platform.deepseek.com.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model is picked in-app (override: DEEPSEEK_MODEL / DEEPSEEK_MODELS="m1,m2").

# --- Web ---
PUBLIC_API_URL=http://localhost:4000
