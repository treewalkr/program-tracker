{
  "name": "program-tracker",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun run --filter @pt/api dev\" \"bun run --filter @pt/web dev\"",
    "dev:api": "bun run --filter @pt/api dev",
    "dev:web": "bun run --filter @pt/web dev",
    "storybook": "bun run --filter @pt/web storybook",
    "build": "bun run --filter '@pt/*' build",
    "test": "bun run --filter @pt/shared test && bun run --filter @pt/db test && bun run --filter @pt/api test && bun run --filter @pt/web test",
    "seed:exercises": "bun run --filter @pt/db seed:exercises",
    "backfill:patterns": "bun run --filter @pt/db backfill:patterns",
    "feedback:export": "bun run apps/api/scripts/feedback-export.ts",
    "llm:export": "bun run apps/api/scripts/llm-export.ts",
    "llm:prune": "bun run apps/api/scripts/llm-prune.ts",
    "release": "bun run scripts/release.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "bun run --filter @pt/db migrate",
    "db:seed": "bun run --filter @pt/db seed:exercises",
    "db:generate": "bun run --filter @pt/db generate",
    "db:studio": "bun run --filter @pt/db studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3"
  }
}
